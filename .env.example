# Biến môi trường — copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git (đã có trong .gitignore)

# YouTube Data API v3
# Lấy tại: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Hugging Face Access Token (cần để tải một số model private/gated)
# Lấy tại: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
